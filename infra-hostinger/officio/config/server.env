# Configuração não secreta do speckle-server da OFFICIO. Segredos: ../secrets/server.env (fora do git).
PORT=3000
CANONICAL_URL="https://speckle.officio.net.br"
FRONTEND_ORIGIN="https://speckle.officio.net.br"
REDIS_URL="redis://redis:6379"
ENABLE_FE2_MESSAGING=false
POSTGRES_URL="postgres"
POSTGRES_USER="speckle"
POSTGRES_DB="speckle"
S3_ENDPOINT="http://minio:9000"
S3_PUBLIC_ENDPOINT="https://files.speckle.officio.net.br"
S3_BUCKET="speckle-server"
S3_CREATE_BUCKET="true"
EMAIL=false
DISABLE_NOTIFICATIONS_CONSUMPTION=false
STRATEGY_LOCAL=true
STRATEGY_OIDC=false
FF_NEXT_GEN_FILE_IMPORTER_ENABLED=true
FILE_SIZE_LIMIT_MB=1000
FILEIMPORT_SERVICE_USE_PRIVATE_OBJECTS_SERVER_URL=false
# Coordenação apenas: o módulo de digital twin (facilities) fica desligado neste servidor.
FF_FACILITIES_MODULE_ENABLED=false
