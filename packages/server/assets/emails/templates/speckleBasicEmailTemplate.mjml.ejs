<mjml>
  <mj-include path="./components/head.mjml" />
  <mj-body>
    <!-- Header -->
    <% if (params.brand?.logoUrl) { %>
    <mj-include path="./components/headerLogoBrand.mjml" />
    <% } else if (params.brand) { %>
    <mj-include path="./components/headerTextBrand.mjml" />
    <% } else { %>
    <mj-include path="./components/headerLogo.mjml" />
    <% } %>

    <!-- Body -->
    <mj-section>
      <mj-column><%- params.body.mjml -%></mj-column>
    </mj-section>

    <% if (params.cta) { %>
    <mj-include path="./components/ctaButton.mjml" />
    <% } %>

    <!-- Body - End -->
    <% if (params.bodyEnd?.mjml?.length) { %>
    <mj-section>
      <mj-column><%- params.bodyEnd?.mjml -%></mj-column>
    </mj-section>
    <% } %> <% if (params.user?.email) { %>
    <mj-section padding="0px">
      <mj-column>
        <mj-text font-size="12px" color="#626263" align="center" padding="0px">
          <p>
            <% if (params.brand) { %>Para não receber estes e-mails, ajuste suas preferências<% } else { %>If you don't want to receive these emails, update your preferences<% } %>
            <a
              href="<%- params.serverInfo.canonicalUrl -%>/profile/<%- params.user.id -%>"
            >
              <% if (params.brand) { %>aqui<% } else { %>here<% } %>
            </a>
            .
          </p>
        </mj-text>
      </mj-column>
    </mj-section>
    <% } %>

    <% if (params.brand) { %>
    <mj-include path="./components/footerBrand.mjml" />
    <% } else { %>
    <mj-include path="./components/footer.mjml" />
    <% } %>
  </mj-body>
</mjml>
