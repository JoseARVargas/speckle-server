PORT=3000
CANONICAL_URL="https://<ec2-ip-with-dashes>.sslip.io"
SESSION_SECRET="<generate a random 64-char hex secret>"
REDIS_URL="redis://redis:6379"
FRONTEND_ORIGIN="https://<ec2-ip-with-dashes>.sslip.io"
ENABLE_FE2_MESSAGING=false
POSTGRES_URL="postgres"
POSTGRES_USER="speckle"
POSTGRES_PASSWORD="<change me>"
POSTGRES_DB="speckle"
S3_ENDPOINT="http://minio:9000"
S3_PUBLIC_ENDPOINT="https://minio-<ec2-ip-with-dashes>.sslip.io"
S3_ACCESS_KEY="<change me>"
S3_SECRET_KEY="<change me>"
S3_BUCKET="speckle-server"
S3_CREATE_BUCKET="true"
EMAIL=false
DISABLE_NOTIFICATIONS_CONSUMPTION=false
STRATEGY_LOCAL=true
STRATEGY_OIDC=false
FF_NEXT_GEN_FILE_IMPORTER_ENABLED=true
FILE_SIZE_LIMIT_MB=1000
FILEIMPORT_SERVICE_USE_PRIVATE_OBJECTS_SERVER_URL=false
FILEIMPORT_QUEUE_POSTGRES_URL='postgresql://speckle:speckle@postgres:5432/speckle'
